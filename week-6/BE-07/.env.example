# Week-6 BE — environment template. Copy to .env and adjust.
# .env is git-ignored (root .gitignore). Loaded via dotenv in src/llm/config.ts.

# LLM provider (OpenAI-compatible chat completions)
LLM_BASE_URL=https://opencode.ai/zen/v1
# Leave empty for OpenCode Zen free tier; the Authorization header is only sent when non-empty.
LLM_API_KEY=
# Free tier models: deepseek-v4-flash-free | minimax-m2.5-free | qwen3.6-plus-free | ring-2.6-1t-free | nemotron-3-super-free
LLM_MODEL=deepseek-v4-flash-free

# 1 = skip the model entirely, return a hard-coded schema-valid answer (zero cost, for building)
LLM_STUB=0
# false = kill switch: skip the model and answer 503 immediately (deterministic fallback)
LLM_ENABLED=true
# Max ms to wait for one model call (the assignment requires 60000 or less)
LLM_TIMEOUT_MS=30000

# Express server
PORT=3000

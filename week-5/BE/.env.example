# We-5 BE · The Polite Scraper — overridable configuration
# Values below are the same as the defaults in src/config.ts, shown for
# documentation. Unset a line to fall back to the default. This file is
# git-ignored; keep real values here, placeholders in .env.example.

# Practice site root (no trailing slash)
SCRAPER_BASE_URL=https://books.toscrape.com

# Identification sent with every request request (politeness layer)
SCRAPER_USER_AGENT=PoliteScraper/1.0 (week-5 BE assignment; contact: jamaludin@example.com)

# Minimum delay between requests, in milliseconds
SCRAPER_DELAY_MS=1500

# Upper bound on how many detail pages to scrape in one run
SCRAPER_LIMIT=50

# 1 = log every request, 0 = quiet
SCRAPER_LOG=1
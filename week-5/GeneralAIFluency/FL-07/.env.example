# FL-07 Asset Signal Scout — environment template
# Copy to .env and fill. .env is gitignored (root .gitignore rule).
# The agent reads these via dotenv-style parsing in src/config.ts.

# Bright Data MCP endpoint (streamable HTTP) — from your Bright Data account
BRIGHT_MCP_URL=

# LLM endpoint (OpenAI-compatible chat completions)
LLM_BASE_URL=https://opencode.ai/zen/v1

LLM_API_KEY=
LLM_MODEL=
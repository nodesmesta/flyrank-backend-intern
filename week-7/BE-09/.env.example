# Week-7 · BE-09 — environment template. Copy to .env and adjust.
# .env is git-ignored (root .gitignore). Loaded via dotenv in src/config.ts.

# Express backend port (the site runs separately with `next dev` on :3001).
PORT=3000

# --- LLM provider (OpenAI-compatible chat completions) ---
# Consumed in Phase 3 by the workflow executor, which sends each node's prompt
# to this model and expects a one-word YES or NO answer. Same three env vars
# as week-6 (A17) — they are the only difference between local and datacentre.
LLM_BASE_URL=https://opencode.ai/zen/v1
# Leave empty for OpenCode Zen free tier; the Authorization header is only sent
# when non-empty (a non-empty dummy key is rejected with 401).
LLM_API_KEY=
# Free-tier model — probe it before use, the free pool rotates:
# (verified live 2026-08-22: deepseek-v4-flash-free "unavailable", works:
#  hy3-free, mimo-v2.5-free, nemotron-3.5-lightning-free, x-preview-f-free…)
LLM_MODEL=hy3-free
# 1 = skip the model entirely (deterministic YES/NO — build/test without calls); 0 = real model
LLM_STUB=0
# false = kill switch: workflow runs fail cleanly with zero model calls
LLM_ENABLED=true
# Max ms to wait for one model call.
LLM_TIMEOUT_MS=30000
